{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catholiccontext.org/schema/catholic-context.schema.json",
  "title": "Catholic Context Knowledge Object",
  "description": "Schema v0.2 for a source-grounded Catholic Context knowledge object. Entity identity is modeled separately from theological claim classification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "entity_type", "summary", "review", "sources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "entity_type": {
      "type": "string",
      "enum": [
        "teaching",
        "concept",
        "sacrament",
        "person",
        "prayer",
        "devotion",
        "liturgy",
        "event",
        "institution",
        "practice",
        "document",
        "source",
        "other"
      ]
    },
    "classification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "type": ["string", "null"],
          "enum": [
            "dogma",
            "doctrine",
            "moral-teaching",
            "discipline",
            "theological-opinion",
            "devotional-practice",
            "historical-claim",
            "prudential-judgment",
            null
          ]
        },
        "certainty": {
          "type": ["string", "null"],
          "enum": ["defined", "authoritatively-taught", "provisional", "disputed", "not-applicable", null]
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "community-reviewed", "theologically-reviewed"]
        },
        "reviewed_by": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "review_commit": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "reference"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "scripture",
              "ecumenical-council",
              "magisterium",
              "catechism",
              "canon-law",
              "church-father",
              "doctor-of-the-church",
              "saint",
              "liturgy",
              "scholarship",
              "other"
            ]
          },
          "reference": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"], "format": "uri" },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "broader": { "type": "array", "items": { "type": "string" } },
        "narrower": { "type": "array", "items": { "type": "string" } },
        "related": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
