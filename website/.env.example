# Build-time public config (safe for the browser)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Worker secrets (set via `wrangler secret put`, never commit):
# SUPABASE_SERVICE_ROLE_KEY
# GITHUB_TOKEN          # PAT or GitHub App installation token with contents + pull_requests
# FOUNDER_ADMIN_TOKEN   # random string for POST /api/admin/appoint
# Optional vars:
# GITHUB_REPO=brennandecker/catholic-context
# GITHUB_PR_BASE=main
