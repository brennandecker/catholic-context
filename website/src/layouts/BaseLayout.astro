---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { jsonLdScript, ogImageUrl, websiteJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  jsonLd?: unknown;
  ogType?: string;
  takeover?: boolean;
}

const {
  title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  robots = 'index, follow',
  jsonLd,
  ogType = 'website',
  takeover = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const normalizedPath =
  canonicalPath === '/' || canonicalPath === '/index.html'
    ? '/'
    : canonicalPath.replace(/\/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '');
const canonical = new URL(normalizedPath === '/' ? '/' : normalizedPath, SITE.url).toString();
const image = ogImageUrl();
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const structured = jsonLd ?? websiteJsonLd();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Catholic Context — open Catholic knowledge for humans and AI" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#f3ead8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IM+Fell+English+SC&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={jsonLdScript(structured)} />
  </head>
  <body class:list={[{ 'has-takeover': takeover }]}>
    <a class="skip-link" href={takeover ? '#library' : '#main'}>Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
