---
import SourceMatchMeter from './SourceMatchMeter.astro';
import type { SourceFidelity } from '../lib/types';

interface Props {
  fidelity?: SourceFidelity | null;
}

const { fidelity } = Astro.props;

function representationLabel(value: string): string {
  return value.replace(/-/g, ' ');
}
---

<section aria-labelledby="source-fidelity-heading">
  <h2 class="h3" id="source-fidelity-heading">Source fidelity</h2>
  {!fidelity ? (
    <p>
      No source-fidelity assessment yet. This checks how faithfully the entry restates its
      cited Church sources. It does not replace theological review of Catholic Context’s framing.
    </p>
  ) : (
    <>
      <SourceMatchMeter confidence={fidelity.confidence} />

      <div class="index-row__meta" style="margin: var(--space-4) 0;">
        <span class="badge">{representationLabel(fidelity.representation)}</span>
        <span class={fidelity.needs_theological_review ? 'badge badge-draft' : 'badge badge-community'}>
          {fidelity.needs_theological_review
            ? 'Needs theological review'
            : 'Not flagged for theological review'}
        </span>
        <span class="badge">
          {fidelity.linkable_sources ? 'Sources linkable' : 'Sources not fully linkable'}
        </span>
      </div>

      {fidelity.rationale && <p>{fidelity.rationale}</p>}

      {fidelity.unresolved_issues && fidelity.unresolved_issues.length > 0 && (
        <ul>
          {fidelity.unresolved_issues.map((issue) => (
            <li>{issue}</li>
          ))}
        </ul>
      )}

      <p class="meta" style="margin-top: var(--space-3);">
        Transparent by design: we show how closely this page matches the cited source.
        {fidelity.assessed_by ? ` Assessed by ${fidelity.assessed_by}.` : ''}
      </p>
    </>
  )}
</section>
