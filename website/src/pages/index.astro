---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import Takeover from '../components/Takeover.astro';
import { SITE, TOPIC_LINKS } from '../lib/site';
---

<BaseLayout
  title="Protecting humanity brick by brick"
  description="Brick by brick, a more just coexistence takes shape, capable of safeguarding the dignity of all. Open Catholic knowledge, a Harness for Catholic-grounded AI, and public evals that keep the human person first."
  takeover
>
  <Takeover />

  <section class="hero shell fade-in" id="library">
    <p class="eyebrow">✦ Open Catholic Knowledge</p>
    <h2 class="display">What does the Catholic Church teach?</h2>
    <p class="lede">
      Explore source-grounded Catholic teaching with transparent citations, provenance,
      and theological review.
    </p>
    <SearchForm />
    <p class="hero-support">Free · Open Source · Built for Humans and AI</p>
    <div class="topic-links" aria-label="Suggested topics">
      {TOPIC_LINKS.map((topic) => (
        <a href={topic.href}>{topic.label}</a>
      ))}
    </div>
  </section>

  <hr class="rule shell" />

  <section class="section shell" aria-labelledby="layers-heading">
    <p class="eyebrow">✦ Three Layers</p>
    <h2 class="h2" id="layers-heading">Open infrastructure for Catholic-grounded AI</h2>
    <div class="columns-3" style="margin-top: var(--space-7);">
      <article>
        <h3 class="h3">Knowledge</h3>
        <p>What does the Church teach?</p>
        <p>
          Structured Catholic teaching with citations, classification, relationships,
          and review metadata.
        </p>
        <a class="btn btn-text" href="/knowledge">Explore Knowledge →</a>
      </article>
      <article>
        <h3 class="h3">Harness</h3>
        <p>How should Catholic-grounded AI behave?</p>
        <p>
          Source grounding, authority distinctions, moral reasoning, uncertainty,
          and pastoral boundaries.
        </p>
        <a class="btn btn-text" href="/harness">Read the Harness →</a>
      </article>
      <article>
        <h3 class="h3">Evals</h3>
        <p>Does it behave faithfully?</p>
        <p>
          Public tests for doctrine, source fidelity, hallucination resistance,
          and spiritual boundaries.
        </p>
        <a class="btn btn-text" href="/evals">View Evals →</a>
      </article>
    </div>
  </section>

  <section class="section shell" aria-labelledby="governance-heading">
    <p class="eyebrow">✦ Accountable by Design</p>
    <h2 class="h2" id="governance-heading">Truth is not determined by popularity.</h2>
    <p class="lede">
      Community contribution can improve clarity and surface problems. It does not
      establish Catholic doctrine.
    </p>
    <ol class="flow-list">
      <li><span class="arrow">↓</span><span>Catholic Sources</span></li>
      <li><span class="arrow">↓</span><span>Structured Context</span></li>
      <li><span class="arrow">↓</span><span>Community Contribution</span></li>
      <li><span class="arrow">↓</span><span>Theological Review</span></li>
      <li><span class="arrow">✦</span><span>Open Versioned Knowledge</span></li>
    </ol>
    <p style="margin-top: var(--space-6);">
      <a class="btn btn-secondary" href="/governance">Read Governance →</a>
    </p>
  </section>

  <section class="section shell" aria-labelledby="open-heading">
    <p class="eyebrow">✦ Built in the Open</p>
    <h2 class="h2" id="open-heading">Catholic knowledge should be inspectable.</h2>
    <p class="lede">
      Read, inspect, download, fork, build, propose corrections, and follow revision
      history. Open source means transparency — not uncontrolled editing of canonical content.
    </p>
    <div style="display:flex; flex-wrap:wrap; gap: var(--space-3); margin-top: var(--space-5);">
      <a class="btn btn-primary" href="/open">Explore Open Foundation →</a>
      <a class="btn btn-secondary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
        View on GitHub ↗
      </a>
    </div>
  </section>

  <section class="section shell" aria-labelledby="mcg-heading">
    <div class="surface" style="padding: clamp(2rem, 5vw, 3.5rem);">
      <p class="eyebrow">✦ Experience the Faith</p>
      <h2 class="h2" id="mcg-heading">Looking for a personal guide?</h2>
      <p class="lede">
        My Catholic Guide is the personal formation and prayer product built on Catholic
        Context — a guided companion for living the faith, while this project remains the
        open scholarly foundation.
      </p>
      <p style="margin-top: var(--space-5);">
        <a class="btn btn-primary" href={SITE.myCatholicGuideUrl} rel="noopener noreferrer" target="_blank">
          Visit My Catholic Guide →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
