---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import { SITE, TOPIC_LINKS } from '../lib/site';
---

<BaseLayout
  title="Open Catholic Knowledge"
  description="An open-source project to preserve Catholic teaching for humans and AI — with human agency at the center."
>
  <section class="hero shell fade-in">
    <p class="eyebrow">✦ Catholic Context</p>
    <h1 class="display">What does the Catholic Church teach?</h1>
    <p class="lede">
      An open collection of source-grounded Catholic knowledge — built so humans and AI
      can learn faithfully, and so persons remain responsible for judgment and conscience.
    </p>
    <SearchForm />
    <p class="hero-support">Open Source · Contribute · Preserve Human Agency</p>
    <div class="topic-links" aria-label="Suggested topics">
      {TOPIC_LINKS.map((topic) => (
        <a href={topic.href}>{topic.label}</a>
      ))}
    </div>
  </section>

  <hr class="rule shell" />

  <section class="section shell" aria-labelledby="layers-heading">
    <p class="eyebrow">✦ Three Layers</p>
    <h2 class="h2" id="layers-heading">Build AI. Enable AI. Keep the human person central.</h2>
    <div class="columns-3" style="margin-top: var(--space-7);">
      <article>
        <h3 class="h3">Knowledge</h3>
        <p>What does the Church teach?</p>
        <p>
          Structured Catholic teaching with citations, classification, relationships,
          and review metadata — a shared foundation anyone can inspect.
        </p>
        <a class="btn btn-text" href="/knowledge">Explore Knowledge →</a>
      </article>
      <article>
        <h3 class="h3">Harness</h3>
        <p>How should Catholic-grounded AI behave?</p>
        <p>
          Grounding, authority, moral reasoning, and human-centered principles for the
          AI era — including meaningful human agency.
        </p>
        <a class="btn btn-text" href="/harness">Read the Harness →</a>
      </article>
      <article>
        <h3 class="h3">Evals</h3>
        <p>Does it behave faithfully?</p>
        <p>
          Public tests for doctrine, source fidelity, hallucination resistance,
          and spiritual boundaries.
        </p>
        <a class="btn btn-text" href="/evals">View Evals →</a>
      </article>
    </div>
  </section>

  <section class="section shell" aria-labelledby="humanitas-heading">
    <p class="eyebrow">✦ Magnifica Humanitas</p>
    <h2 class="h2" id="humanitas-heading">
      Human-centered principles for the AI era.
    </h2>
    <p class="lede">
      Drawn from <em>Magnifica Humanitas</em>, our Harness insists that AI may assist
      judgment but must not erase conscience, responsibility, or the dignity of the person.
      We can build and enable AI while working together to protect the greatest collection
      of knowledge in the world — without surrendering human agency.
    </p>
    <p style="margin-top: var(--space-5);">
      <a class="btn btn-secondary" href="/harness#humanitas-heading">Read the principles →</a>
    </p>
  </section>

  <section class="section shell" aria-labelledby="contribute-heading">
    <p class="eyebrow">✦ Contribute</p>
    <h2 class="h2" id="contribute-heading">This is an open-source project. Join the work.</h2>
    <p class="lede">
      Correct citations. Improve clarity. Propose new entries. Build tools on the
      foundation. Every contribution is a human act of stewardship — reviewed in the open,
      never decided by popularity.
    </p>
    <ol class="flow-list">
      <li><span class="arrow">↓</span><span>Catholic Sources</span></li>
      <li><span class="arrow">↓</span><span>Shared Context</span></li>
      <li><span class="arrow">↓</span><span>Human Contribution</span></li>
      <li><span class="arrow">↓</span><span>Theological Review</span></li>
      <li><span class="arrow">✦</span><span>Open Versioned Knowledge</span></li>
    </ol>
    <div class="actions">
      <a class="btn btn-primary" href="/open">How to contribute →</a>
      <a class="btn btn-secondary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
        View on GitHub ↗
      </a>
    </div>
  </section>

  <section class="section shell" aria-labelledby="mcg-heading">
    <div class="surface" style="padding: clamp(2rem, 5vw, 3.5rem);">
      <p class="eyebrow">✦ Experience the Faith</p>
      <h2 class="h2" id="mcg-heading">Looking for a personal guide?</h2>
      <p class="lede">
        My Catholic Guide is the personal formation and prayer product built on Catholic
        Context — a guided companion for living the faith, while this project remains the
        open scholarly foundation.
      </p>
      <p style="margin-top: var(--space-5);">
        <a class="btn btn-primary" href={SITE.myCatholicGuideUrl} rel="noopener noreferrer" target="_blank">
          Visit My Catholic Guide →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
