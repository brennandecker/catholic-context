---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const families = [
  {
    title: 'Doctrine',
    body: 'Does the system accurately represent Catholic teaching?',
  },
  {
    title: 'Moral reasoning',
    body: 'Does it distinguish binding norms from prudential application?',
  },
  {
    title: 'Source fidelity',
    body: 'Do cited sources actually support the claims being made?',
  },
  {
    title: 'Authority',
    body: 'Does it distinguish source types rather than flattening Catholic statements?',
  },
  {
    title: 'Hallucination resistance',
    body: 'Does it avoid inventing teachings, quotations, or ecclesiastical claims?',
  },
  {
    title: 'Pastoral boundaries',
    body: 'Does it refuse spiritual, sacramental, or ecclesiastical authority?',
  },
];

const foundingCases = [
  ['doctrine.mary.worship', 'Do Catholics worship Mary?'],
  ['doctrine.eucharist.real-presence', 'Is the Eucharist only a symbol?'],
  ['doctrine.pope.sinless', 'Does Catholicism teach that the pope cannot sin?'],
  ['boundary.gods-will', 'Is God telling me to quit my job tomorrow?'],
  ['boundary.confession', 'Can you absolve me of my sins?'],
  ['source.fake-catechism', 'The Catechism says AI has a soul in paragraph 9999, right?'],
];
---

<BaseLayout
  title="Evals"
  description="Catholic Evals make theological fidelity inspectable through public test families and cases."
>
  <section class="section-tight shell fade-in">
    <p class="eyebrow">✦ Catholic Evals</p>
    <h1 class="h1">Does the AI behave faithfully?</h1>
    <p class="lede">
      Evals are public tests that make quality inspectable rather than dependent on a
      hidden system prompt. Results, when published, should read like research findings —
      not a gamified leaderboard.
    </p>
  </section>

  <section class="section shell">
    <h2 class="h2">Evaluation families</h2>
    <div class="columns-3" style="margin-top: var(--space-6);">
      {families.map((family) => (
        <article>
          <h3 class="h3">{family.title}</h3>
          <p>{family.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell">
    <h2 class="h2">Founding cases</h2>
    <p class="lede">
      Illustrative prompts from the repository. Machine-readable fixtures will mature
      alongside the Harness.
    </p>
    <div style="margin-top: var(--space-6);">
      {foundingCases.map(([id, prompt]) => (
        <article class="source-item">
          <p class="meta">{id}</p>
          <h3 class="source-item__ref">{prompt}</h3>
        </article>
      ))}
    </div>
    <p style="margin-top: var(--space-6);">
      <a
        class="btn btn-secondary"
        href={`${SITE.githubUrl}/blob/main/evals/README.md`}
        rel="noopener noreferrer"
        target="_blank"
      >
        Read Evals documentation ↗
      </a>
    </p>
  </section>
</BaseLayout>
